    {
      "parameters": {
        "jsCode": "const habitos = $input.all();\n\nif (habitos.length === 0) {\n  return { mensagem: \"Você ainda não registrou nenhum hábito! 😴\" };\n}\n\n// Filtra linhas que têm data válida\nconst datasValidas = habitos\n  .map(h => h.json.data)\n  .filter(d => d !== undefined && d !== null && String(d).includes('/'));\n\nif (datasValidas.length === 0) {\n  return { mensagem: \"Nenhum hábito com data válida encontrado!\" };\n}\n\n// Pega datas únicas e ordena\nconst datas = [...new Set(datasValidas)];\n\nconst datasOrdenadas = datas\n  .map(d => {\n    const [dia, mes, ano] = d.split('/');\n    return new Date(`${ano}-${mes}-${dia}`);\n  })\n  .sort((a, b) => b - a);\n\nlet streak = 1;\nfor (let i = 0; i < datasOrdenadas.length - 1; i++) {\n  const diff = (datasOrdenadas[i] - datasOrdenadas[i + 1]) / (1000 * 60 * 60 * 24);\n  if (diff === 1) {\n    streak++;\n  } else {\n    break;\n  }\n}\n\nreturn { mensagem: `🔥 Seu streak atual é de *${streak} dia(s)* consecutivo(s)!` };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
