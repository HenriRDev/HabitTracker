    {
      "parameters": {
        "jsCode": "const habitos = $input.all();\n\nif (habitos.length === 0) {\n  return { mensagem: \"Você não registrou nenhum hábito hoje ainda! 😴\" };\n}\n\nconst lista = habitos.map(h => \n  `• ${h.json.habito} (${h.json.categoria} - ${h.json.duracao_minutos || '?'} min)`\n).join('\\n');\n\nreturn { mensagem: `Seus hábitos de hoje:\\n\\n${lista}` };"
      },
